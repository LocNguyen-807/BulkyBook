@using BulkyBookModels
@using BulkyBookUtility
@model OrderHeader

@{
    var isCustomer = User.IsInRole(SD.RoleCustomer);
    var containerClass = isCustomer ? "container my-4 pt-3" : "container-fluid py-4";
}

<div class="@containerClass">
    <form method="post">
        @* TODO: Add hidden input for order ID *@
        <input hidden asp-for="@Model.Id"/>

        <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
            <i class="bi bi-arrow-left"></i> Back to orders
        </a>

        <div class="card border shadow-sm overflow-hidden">
            <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-receipt me-2"></i>Order #<span>@Model.Id</span>
                    @* TODO: Display order ID *@
                </h5>
                <p class="mb-0 small" style="color: #1DB954;">Placed on <span>@Model.OrderDate.ToString("dd/MM/yyyy")</span></p>
            </div>

            <div class="card-body p-4">
                <div class="row g-5">
                    <!-- Left column: Shipping info -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Order Details
                        </h6>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Name</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input type="text" readonly class="form-control form-control-sm" asp-for="@Model.Name" />
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.Name" />
                                    <span class="text-danger small" asp-validation-for="Name"></span>
                                }
                                
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Phone</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input readonly type="text" class="form-control form-control-sm" asp-for="@Model.PhoneNumber" />

                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.PhoneNumber" />
                                    <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
                                }
                                
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Address</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input readonly type="text" class="form-control form-control-sm" asp-for="@Model.StreetAddress" />
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.StreetAddress" />
                                    <span class="text-danger small" asp-validation-for="StreetAddress"></span>
                                }
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">City</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input readonly type="text" class="form-control form-control-sm" asp-for="@Model.City" />
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.City" />
                                    <span class="text-danger small" asp-validation-for="City"></span>
                                }
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">State</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input readonly type="text" class="form-control form-control-sm" asp-for="@Model.State" />
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.State" />
                                    <span class="text-danger small" asp-validation-for="State"></span>
                                }
                                
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Zip Code</label>
                            <div class="col-8">
                                @if (isCustomer)
                                {
                                    <input readonly type="text" class="form-control form-control-sm" asp-for="@Model.PostalCode" />
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm" asp-for="@Model.PostalCode" />
                                    <span class="text-danger small" asp-validation-for="PostalCode"></span>
                                }
                                
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Email</label>
                            <div class="col-8">
                                <input type="email" readonly class="form-control-plaintext form-control-sm" asp-for="@Model.ApplicationUser.Email" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Order Date</label>
                            <div class="col-8">
                                <input type="text" readonly class="form-control-plaintext form-control-sm" asp-for="OrderDate"
                                       asp-format="{0:dd/MM/yyyy}" />
                            </div>
                        </div>

                        @if (Model.OrderStatus?.ToLower() != "pending" && Model.OrderStatus?.ToLower() != "approved" && Model.OrderStatus?.ToLower() != "cancelled")
                            {
                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Carrier</label>
                                <div class="col-8">
                                    @if(isCustomer){
                                        <input readonly type="text" id="carrier" class="form-control form-control-sm" asp-for="Carrier" />
                                    }else
                                    {
                                        <input type="text" id="carrier" class="form-control form-control-sm" asp-for="Carrier" />
                                    } 
                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Tracking</label>
                                <div class="col-8">
                                    @if(isCustomer){
                                        <input readonly type="text" id="trackingNumber" class="form-control form-control-sm" asp-for="TrackingNumber" />
                                    }else
                                    {
                                        <input type="text" id="trackingNumber" class="form-control form-control-sm" asp-for="TrackingNumber" />
                                    } 
                                </div>
                            </div>
                            }
                            

                        @if(Model.ShippingDate != default(DateTime))
                        {
                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Shipping Date</label>
                                <div class="col-8">
                                    <input type="text" readonly class="form-control-plaintext form-control-sm" asp-for="ShippingDate" />
                                </div>
                            </div>
                        }

                            @if(User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
                            {
                            <button asp-action="UpdateOrderDetails" type="submit" class="btn btn-accent w-100 fw-semibold mt-3">
                                Update Order Details
                            </button>    
                            }
                            
                    </div>

                    <!-- Right column: Order summary -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Order Summary
                        </h6>

                        <span class="badge bg-dark mb-3">
                            <i class="bi bi-info-circle me-1"></i> <span>@Model.OrderStatus</span>
                        </span>

                        <div class="border rounded overflow-hidden mb-4">
                            @* TODO: Loop through order items *@
                                @foreach(var item in Model.OrderDetails)
                                {
                                <div class="d-flex justify-content-between align-items-start p-3 border-bottom">
                                    <div>
                                        <p class="fw-medium small mb-0">@item.Product.Title</p>
                                        @* TODO: Display product title *@
                                        <p class="text-secondary mb-0" style="font-size: 0.75rem;">
                                            @item.Price.ToString("c") x @item.Count
                                        </p>
                                    </div>
                                    <p class="fw-semibold small mb-0" style="color: #17A34A;">
                                        @((item.Price * item.Count).ToString("c"))
                                    </p>
                                </div>
                                }
                            
                            <div class="d-flex justify-content-between align-items-center p-3 text-white" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                                <span class="fw-bold small text-uppercase">Total</span>
                                <span class="fw-bold fs-5">@Model.OrderTotal.ToString("c")</span>
                            </div>
                        </div>

                            @if(User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
                            {
                                <div class="d-grid gap-2">
                                    @if (Model.OrderStatus == SD.StatusApproved)
                                    {
                                        <button type="submit" asp-action="UpdateOrderStatus" asp-route-status="@SD.StatusInProcess" class="btn btn-accent fw-semibold">
                                            <i class="bi bi-arrow-right-circle me-1"></i>  Start Processing
                                        </button>
                                    }
                                    @if (Model.OrderStatus == SD.StatusInProcess)
                                    {
                                        <button asp-action="UpdateOrderStatus" asp-route-status="@SD.StatusShipped" type="submit" onclick="return validateInput()" class="btn btn-warning fw-semibold">
                                            <i class="bi bi-truck me-1"></i>   Ship Order
                                        </button>
                                    }

                                    @if (Model.OrderStatus == SD.StatusApproved || Model.OrderStatus == SD.StatusInProcess)
                                    {
                                        <button asp-action="UpdateOrderStatus" asp-route-status="@SD.StatusCancelled" type="submit" class="btn btn-danger fw-semibold">
                                            <i class="bi bi-x-circle me-1"></i>  Cancel Order
                                        </button>
                                    }
                                </div>
                            }

                        
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
